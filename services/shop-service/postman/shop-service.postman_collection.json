{
  "info": {
    "name": "Shop Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8082" },
    { "key": "token", "value": "" },
    { "key": "productId", "value": "1" },
    { "key": "warehouseId", "value": "1" },
    { "key": "districtId", "value": "1" },
    { "key": "customerId", "value": "1" },
    { "key": "orderId", "value": "1" }
  ],
  "item": [
    {
      "name": "Products",
      "item": [
        {
          "name": "List products by price",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Products are listed', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().content).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/shop/products?search=lamp&sort=price&direction=desc&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "shop", "products"],
              "query": [
                { "key": "search", "value": "lamp" },
                { "key": "sort", "value": "price" },
                { "key": "direction", "value": "desc" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Create product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Product is created', function () { pm.response.to.have.status(201); });",
                  "pm.test('Location is returned', function () { pm.response.to.have.header('Location'); });",
                  "pm.collectionVariables.set('productId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Desk Lamp\",\n  \"price\": 24.50,\n  \"category\": \"Home\",\n  \"brand\": \"Lumen\"\n}"
            },
            "url": "{{baseUrl}}/api/shop/products"
          }
        },
        {
          "name": "Create product with a price above the limit",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Price is rejected', function () { pm.response.to.have.status(400); });"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Gold Bar\",\n  \"price\": 1000,\n  \"category\": \"Metal\",\n  \"brand\": \"Mint\"\n}"
            },
            "url": "{{baseUrl}}/api/shop/products"
          }
        },
        {
          "name": "Update product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Product is updated', function () { pm.response.to.have.status(200); });"]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Desk Lamp\",\n  \"price\": 22.00,\n  \"category\": \"Home\",\n  \"brand\": \"Lumen\"\n}"
            },
            "url": "{{baseUrl}}/api/shop/products/{{productId}}"
          }
        },
        {
          "name": "Delete product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Product without order lines is deleted, ordered product is refused', function () {",
                  "  pm.expect([204, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/shop/products/{{productId}}"
          }
        }
      ]
    },
    {
      "name": "Warehouses",
      "item": [
        {
          "name": "List warehouses",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Warehouses are listed', function () { pm.response.to.have.status(200); });"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/shop/warehouses?sort=city&direction=asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "shop", "warehouses"],
              "query": [
                { "key": "sort", "value": "city" },
                { "key": "direction", "value": "asc" }
              ]
            }
          }
        },
        {
          "name": "Create warehouse",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Warehouse is created', function () { pm.response.to.have.status(201); });"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"North\",\n  \"city\": \"Ankara\",\n  \"region\": \"Central\"\n}"
            },
            "url": "{{baseUrl}}/api/shop/warehouses"
          }
        }
      ]
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "List customers of a warehouse",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Customers are listed', function () { pm.response.to.have.status(200); });"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/shop/customers?warehouseId={{warehouseId}}&search=an&sort=lastName",
              "host": ["{{baseUrl}}"],
              "path": ["api", "shop", "customers"],
              "query": [
                { "key": "warehouseId", "value": "{{warehouseId}}" },
                { "key": "search", "value": "an" },
                { "key": "sort", "value": "lastName" }
              ]
            }
          }
        },
        {
          "name": "Create customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Customer is created', function () { pm.response.to.have.status(201); });"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"warehouseId\": {{warehouseId}},\n  \"districtId\": {{districtId}},\n  \"firstName\": \"Ayse\",\n  \"lastName\": \"Demir\",\n  \"email\": \"ayse.demir@example.com\",\n  \"city\": \"Ankara\",\n  \"region\": \"Central\"\n}"
            },
            "url": "{{baseUrl}}/api/shop/customers"
          }
        },
        {
          "name": "Get customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Customer is found', function () { pm.response.to.have.status(200); });"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/shop/customers/{{warehouseId}}/{{districtId}}/{{customerId}}"
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "List orders of November",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Orders are listed', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().content).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/shop/orders?warehouseId={{warehouseId}}&from=2026-11-01&to=2026-11-30&sort=totalAmount&direction=desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "shop", "orders"],
              "query": [
                { "key": "warehouseId", "value": "{{warehouseId}}" },
                { "key": "from", "value": "2026-11-01" },
                { "key": "to", "value": "2026-11-30" },
                { "key": "sort", "value": "totalAmount" },
                { "key": "direction", "value": "desc" }
              ]
            }
          }
        },
        {
          "name": "Order detail with lines",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Order has lines', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().lines).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/shop/orders/{{warehouseId}}/{{districtId}}/{{orderId}}"
          }
        }
      ]
    },
    {
      "name": "Access control",
      "item": [
        {
          "name": "Health without a token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Health is public', function () { pm.response.to.have.status(200); });"]
              }
            }
          ],
          "auth": { "type": "noauth" },
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/actuator/health"
          }
        },
        {
          "name": "API without a token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Token is required', function () { pm.expect([401, 403]).to.include(pm.response.code); });"]
              }
            }
          ],
          "auth": { "type": "noauth" },
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/shop/products"
          }
        }
      ]
    }
  ]
}
