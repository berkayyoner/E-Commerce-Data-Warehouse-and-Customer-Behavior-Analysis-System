{
  "info": {
    "name": "Shop Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const expiresAt = Number(pm.environment.get('accessTokenExpiresAt') || 0);",
          "const tokenValid = Boolean(pm.environment.get('accessToken')) && Date.now() < expiresAt - 30000;",
          "if (!tokenValid) {",
          "  pm.sendRequest({",
          "    url: pm.environment.get('authUrl') + '/auth/login',",
          "    method: 'POST',",
          "    header: { 'Content-Type': 'application/json' },",
          "    body: {",
          "      mode: 'raw',",
          "      raw: JSON.stringify({",
          "        username: pm.environment.get('username'),",
          "        password: pm.environment.get('password')",
          "      })",
          "    }",
          "  }, function (error, response) {",
          "    if (error || response.code !== 200) {",
          "      throw new Error('Sign-in at ' + pm.environment.get('authUrl') + ' failed' + (response ? ' with status ' + response.code : ''));",
          "    }",
          "    const body = response.json();",
          "    pm.environment.set('accessToken', body.access_token);",
          "    pm.environment.set('accessTokenExpiresAt', String(Date.now() + body.expires_in * 1000));",
          "  });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "shopUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "productId",
      "value": "1"
    },
    {
      "key": "warehouseId",
      "value": "1"
    },
    {
      "key": "districtId",
      "value": "1"
    },
    {
      "key": "customerId",
      "value": "1"
    },
    {
      "key": "orderId",
      "value": "1"
    },
    {
      "key": "createdWarehouseId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Products",
      "item": [
        {
          "name": "List products by price",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Products are listed', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().content).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{shopUrl}}/api/shop/products?search=lamp&sort=price&direction=desc&size=10",
              "host": [
                "{{shopUrl}}"
              ],
              "path": [
                "api",
                "shop",
                "products"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "lamp"
                },
                {
                  "key": "sort",
                  "value": "price"
                },
                {
                  "key": "direction",
                  "value": "desc"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Create product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Product is created', function () { pm.response.to.have.status(201); });",
                  "pm.test('Location is returned', function () { pm.response.to.have.header('Location'); });",
                  "pm.collectionVariables.set('productId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Desk Lamp\",\n  \"price\": 24.50,\n  \"category\": \"Home\",\n  \"brand\": \"Lumen\"\n}"
            },
            "url": "{{shopUrl}}/api/shop/products"
          }
        },
        {
          "name": "Create product with a price above the limit",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Price is rejected', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Gold Bar\",\n  \"price\": 1000,\n  \"category\": \"Metal\",\n  \"brand\": \"Mint\"\n}"
            },
            "url": "{{shopUrl}}/api/shop/products"
          }
        },
        {
          "name": "Update product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Product is updated', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Desk Lamp\",\n  \"price\": 22.00,\n  \"category\": \"Home\",\n  \"brand\": \"Lumen\"\n}"
            },
            "url": "{{shopUrl}}/api/shop/products/{{productId}}"
          }
        },
        {
          "name": "Delete product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Product without order lines is deleted, ordered product is refused', function () {",
                  "  pm.expect([204, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{shopUrl}}/api/shop/products/{{productId}}"
          }
        }
      ]
    },
    {
      "name": "Warehouses",
      "item": [
        {
          "name": "List warehouses",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Warehouses are listed', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{shopUrl}}/api/shop/warehouses?sort=city&direction=asc",
              "host": [
                "{{shopUrl}}"
              ],
              "path": [
                "api",
                "shop",
                "warehouses"
              ],
              "query": [
                {
                  "key": "sort",
                  "value": "city"
                },
                {
                  "key": "direction",
                  "value": "asc"
                }
              ]
            }
          }
        },
        {
          "name": "Create warehouse",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Warehouse is created', function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.collectionVariables.set('createdWarehouseId', pm.response.json().id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"North\",\n  \"city\": \"Ankara\",\n  \"region\": \"Central\"\n}"
            },
            "url": "{{shopUrl}}/api/shop/warehouses"
          }
        },
        {
          "name": "Delete the created warehouse",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Warehouse is deleted again', function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{shopUrl}}/api/shop/warehouses/{{createdWarehouseId}}"
          }
        }
      ]
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "List customers of a warehouse",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Customers are listed', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{shopUrl}}/api/shop/customers?warehouseId={{warehouseId}}&search=an&sort=lastName",
              "host": [
                "{{shopUrl}}"
              ],
              "path": [
                "api",
                "shop",
                "customers"
              ],
              "query": [
                {
                  "key": "warehouseId",
                  "value": "{{warehouseId}}"
                },
                {
                  "key": "search",
                  "value": "an"
                },
                {
                  "key": "sort",
                  "value": "lastName"
                }
              ]
            }
          }
        },
        {
          "name": "Create customer in an unknown district is rejected",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('The district must be between 1 and 10', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"warehouseId\": {{warehouseId}},\n  \"districtId\": 99,\n  \"firstName\": \"Ayse\",\n  \"lastName\": \"Demir\",\n  \"email\": \"ayse.demir@example.com\",\n  \"city\": \"Ankara\",\n  \"region\": \"Central\"\n}"
            },
            "url": "{{shopUrl}}/api/shop/customers"
          }
        },
        {
          "name": "Get customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Customer is found', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{shopUrl}}/api/shop/customers/{{warehouseId}}/{{districtId}}/{{customerId}}"
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "List orders of November",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Orders are listed', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().content).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{shopUrl}}/api/shop/orders?warehouseId={{warehouseId}}&from=2026-11-01&to=2026-11-30&sort=totalAmount&direction=desc",
              "host": [
                "{{shopUrl}}"
              ],
              "path": [
                "api",
                "shop",
                "orders"
              ],
              "query": [
                {
                  "key": "warehouseId",
                  "value": "{{warehouseId}}"
                },
                {
                  "key": "from",
                  "value": "2026-11-01"
                },
                {
                  "key": "to",
                  "value": "2026-11-30"
                },
                {
                  "key": "sort",
                  "value": "totalAmount"
                },
                {
                  "key": "direction",
                  "value": "desc"
                }
              ]
            }
          }
        },
        {
          "name": "Order detail with lines",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Order has lines', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().lines).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{shopUrl}}/api/shop/orders/{{warehouseId}}/{{districtId}}/{{orderId}}"
          }
        }
      ]
    },
    {
      "name": "Search",
      "item": [
        {
          "name": "Search products in English",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Search answers a page with facets', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var body = pm.response.json();",
                  "  pm.expect(body.content).to.be.an('array');",
                  "  pm.expect(body.facets.categories).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{shopUrl}}/api/shop/search/products?q=lamp&lang=en&sort=relevance&size=10"
          }
        },
        {
          "name": "Search products in Turkish",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Turkish category labels are returned', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.response.json().content.forEach(function (hit) { pm.expect(hit.categoryLabel).to.be.a('string'); });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{shopUrl}}/api/shop/search/products?q=oyuncak&lang=tr&category=Toys and Games&size=10"
          }
        },
        {
          "name": "Search products by price range",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Prices stay inside the range', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.response.json().content.forEach(function (hit) { pm.expect(hit.price).to.be.within(10, 50); });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{shopUrl}}/api/shop/search/products?minPrice=10&maxPrice=50&sort=priceAsc&size=10"
          }
        },
        {
          "name": "Search with an unknown sort",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unknown sort is rejected', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{shopUrl}}/api/shop/search/products?sort=password"
          }
        },
        {
          "name": "Suggest while typing",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Suggestions are typed', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.response.json().forEach(function (s) { pm.expect(['PRODUCT', 'CATEGORY', 'BRAND']).to.include(s.type); });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{shopUrl}}/api/shop/search/suggest?q=la&lang=en&size=8"
          }
        },
        {
          "name": "Start a full reindex",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Reindex is accepted', function () { pm.response.to.have.status(202); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{shopUrl}}/api/shop/search/reindex"
          }
        },
        {
          "name": "Reindex status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status names the state', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(['IDLE', 'RUNNING', 'SUCCESS', 'FAILED']).to.include(pm.response.json().state);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{shopUrl}}/api/shop/search/reindex"
          }
        }
      ]
    },
    {
      "name": "Access control",
      "item": [
        {
          "name": "Health without a token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Health is public', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{shopUrl}}/actuator/health",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "API without a token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Token is required', function () { pm.expect([401, 403]).to.include(pm.response.code); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{shopUrl}}/api/shop/products",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    }
  ]
}
