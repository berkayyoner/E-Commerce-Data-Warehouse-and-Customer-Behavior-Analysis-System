{
  "info": {
    "name": "Analytics Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const expiresAt = Number(pm.environment.get('accessTokenExpiresAt') || 0);",
          "const tokenValid = Boolean(pm.environment.get('accessToken')) && Date.now() < expiresAt - 30000;",
          "if (!tokenValid) {",
          "  pm.sendRequest({",
          "    url: pm.environment.get('authUrl') + '/auth/login',",
          "    method: 'POST',",
          "    header: { 'Content-Type': 'application/json' },",
          "    body: {",
          "      mode: 'raw',",
          "      raw: JSON.stringify({",
          "        username: pm.environment.get('username'),",
          "        password: pm.environment.get('password')",
          "      })",
          "    }",
          "  }, function (error, response) {",
          "    if (error || response.code !== 200) {",
          "      throw new Error('Sign-in at ' + pm.environment.get('authUrl') + ' failed' + (response ? ' with status ' + response.code : ''));",
          "    }",
          "    const body = response.json();",
          "    pm.environment.set('accessToken', body.access_token);",
          "    pm.environment.set('accessTokenExpiresAt', String(Date.now() + body.expires_in * 1000));",
          "  });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "analyticsUrl",
      "value": "http://localhost:8083"
    },
    {
      "key": "from",
      "value": "2026-01-01"
    },
    {
      "key": "to",
      "value": "2026-03-31"
    }
  ],
  "item": [
    {
      "name": "Overview",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{analyticsUrl}}/api/analytics/overview?from={{from}}&to={{to}}",
          "host": [
            "{{analyticsUrl}}"
          ],
          "path": [
            "api",
            "analytics",
            "overview"
          ],
          "query": [
            {
              "key": "from",
              "value": "{{from}}"
            },
            {
              "key": "to",
              "value": "{{to}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Overview answers with a cache header', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.headers.get('X-Cache')).to.be.oneOf(['HIT', 'MISS']);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Sales trend by month",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{analyticsUrl}}/api/analytics/sales/trend?granularity=month",
          "host": [
            "{{analyticsUrl}}"
          ],
          "path": [
            "api",
            "analytics",
            "sales",
            "trend"
          ],
          "query": [
            {
              "key": "granularity",
              "value": "month"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Trend is a list of periods', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Sales trend with an invalid granularity",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{analyticsUrl}}/api/analytics/sales/trend?granularity=hour",
          "host": [
            "{{analyticsUrl}}"
          ],
          "path": [
            "api",
            "analytics",
            "sales",
            "trend"
          ],
          "query": [
            {
              "key": "granularity",
              "value": "hour"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Unknown granularity is rejected', function () {",
              "  pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Top products by units",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{analyticsUrl}}/api/analytics/products/top?by=units&limit=10",
          "host": [
            "{{analyticsUrl}}"
          ],
          "path": [
            "api",
            "analytics",
            "products",
            "top"
          ],
          "query": [
            {
              "key": "by",
              "value": "units"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        }
      }
    },
    {
      "name": "Categories",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{analyticsUrl}}/api/analytics/categories",
          "host": [
            "{{analyticsUrl}}"
          ],
          "path": [
            "api",
            "analytics",
            "categories"
          ]
        }
      }
    },
    {
      "name": "Regions",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{analyticsUrl}}/api/analytics/regions?from={{from}}&to={{to}}",
          "host": [
            "{{analyticsUrl}}"
          ],
          "path": [
            "api",
            "analytics",
            "regions"
          ],
          "query": [
            {
              "key": "from",
              "value": "{{from}}"
            },
            {
              "key": "to",
              "value": "{{to}}"
            }
          ]
        }
      }
    },
    {
      "name": "Payments",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{analyticsUrl}}/api/analytics/payments",
          "host": [
            "{{analyticsUrl}}"
          ],
          "path": [
            "api",
            "analytics",
            "payments"
          ]
        }
      }
    },
    {
      "name": "Fulfillment",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{analyticsUrl}}/api/analytics/fulfillment?from={{from}}&to={{to}}",
          "host": [
            "{{analyticsUrl}}"
          ],
          "path": [
            "api",
            "analytics",
            "fulfillment"
          ],
          "query": [
            {
              "key": "from",
              "value": "{{from}}"
            },
            {
              "key": "to",
              "value": "{{to}}"
            }
          ]
        }
      }
    },
    {
      "name": "Customers top 20",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{analyticsUrl}}/api/analytics/customers/top?limit=20",
          "host": [
            "{{analyticsUrl}}"
          ],
          "path": [
            "api",
            "analytics",
            "customers",
            "top"
          ],
          "query": [
            {
              "key": "limit",
              "value": "20"
            }
          ]
        }
      }
    },
    {
      "name": "Customer metrics",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{analyticsUrl}}/api/analytics/customers/metrics",
          "host": [
            "{{analyticsUrl}}"
          ],
          "path": [
            "api",
            "analytics",
            "customers",
            "metrics"
          ]
        }
      }
    },
    {
      "name": "Benchmark (OLTP vs star vs view)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{analyticsUrl}}/api/analytics/benchmark",
          "host": [
            "{{analyticsUrl}}"
          ],
          "path": [
            "api",
            "analytics",
            "benchmark"
          ]
        }
      }
    },
    {
      "name": "Clear report cache",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{analyticsUrl}}/api/analytics/cache/clear",
          "host": [
            "{{analyticsUrl}}"
          ],
          "path": [
            "api",
            "analytics",
            "cache",
            "clear"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Cache clear reports the deleted count', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().deleted).to.be.a('number');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "API without a token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('A token is required', function () { pm.expect([401, 403]).to.include(pm.response.code); });"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "url": "{{analyticsUrl}}/api/analytics/overview"
      }
    }
  ]
}
