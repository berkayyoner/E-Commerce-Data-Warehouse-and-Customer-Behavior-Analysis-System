{
  "info": {
    "name": "Analytics Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "oauth2",
    "oauth2": [
      {
        "key": "grant_type",
        "value": "authorization_code_with_pkce",
        "type": "string"
      },
      {
        "key": "authUrl",
        "value": "{{authUrl}}/oauth2/authorize",
        "type": "string"
      },
      {
        "key": "accessTokenUrl",
        "value": "{{authUrl}}/oauth2/token",
        "type": "string"
      },
      {
        "key": "clientId",
        "value": "{{clientId}}",
        "type": "string"
      },
      {
        "key": "scope",
        "value": "openid dwh.read dwh.write",
        "type": "string"
      },
      {
        "key": "redirect_uri",
        "value": "https://oauth.pstmn.io/v1/callback",
        "type": "string"
      },
      {
        "key": "challengeAlgorithm",
        "value": "S256",
        "type": "string"
      },
      {
        "key": "client_authentication",
        "value": "body",
        "type": "string"
      },
      {
        "key": "addTokenTo",
        "value": "header",
        "type": "string"
      },
      {
        "key": "tokenName",
        "value": "dwh-access-token",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "analyticsUrl",
      "value": "http://localhost:8083"
    },
    {
      "key": "from",
      "value": "2026-01-01"
    },
    {
      "key": "to",
      "value": "2026-03-31"
    }
  ],
  "item": [
    {
      "name": "Overview",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{analyticsUrl}}/api/analytics/overview?from={{from}}&to={{to}}",
          "host": [
            "{{analyticsUrl}}"
          ],
          "path": [
            "api",
            "analytics",
            "overview"
          ],
          "query": [
            {
              "key": "from",
              "value": "{{from}}"
            },
            {
              "key": "to",
              "value": "{{to}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Overview answers with a cache header', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.headers.get('X-Cache')).to.be.oneOf(['HIT', 'MISS']);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Sales trend by month",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{analyticsUrl}}/api/analytics/sales/trend?granularity=month",
          "host": [
            "{{analyticsUrl}}"
          ],
          "path": [
            "api",
            "analytics",
            "sales",
            "trend"
          ],
          "query": [
            {
              "key": "granularity",
              "value": "month"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Trend is a list of periods', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Sales trend with an invalid granularity",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{analyticsUrl}}/api/analytics/sales/trend?granularity=hour",
          "host": [
            "{{analyticsUrl}}"
          ],
          "path": [
            "api",
            "analytics",
            "sales",
            "trend"
          ],
          "query": [
            {
              "key": "granularity",
              "value": "hour"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Unknown granularity is rejected', function () {",
              "  pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Top products by units",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{analyticsUrl}}/api/analytics/products/top?by=units&limit=10",
          "host": [
            "{{analyticsUrl}}"
          ],
          "path": [
            "api",
            "analytics",
            "products",
            "top"
          ],
          "query": [
            {
              "key": "by",
              "value": "units"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        }
      }
    },
    {
      "name": "Categories",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{analyticsUrl}}/api/analytics/categories",
          "host": [
            "{{analyticsUrl}}"
          ],
          "path": [
            "api",
            "analytics",
            "categories"
          ]
        }
      }
    },
    {
      "name": "Regions",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{analyticsUrl}}/api/analytics/regions?from={{from}}&to={{to}}",
          "host": [
            "{{analyticsUrl}}"
          ],
          "path": [
            "api",
            "analytics",
            "regions"
          ],
          "query": [
            {
              "key": "from",
              "value": "{{from}}"
            },
            {
              "key": "to",
              "value": "{{to}}"
            }
          ]
        }
      }
    },
    {
      "name": "Payments",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{analyticsUrl}}/api/analytics/payments",
          "host": [
            "{{analyticsUrl}}"
          ],
          "path": [
            "api",
            "analytics",
            "payments"
          ]
        }
      }
    },
    {
      "name": "Fulfillment",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{analyticsUrl}}/api/analytics/fulfillment?from={{from}}&to={{to}}",
          "host": [
            "{{analyticsUrl}}"
          ],
          "path": [
            "api",
            "analytics",
            "fulfillment"
          ],
          "query": [
            {
              "key": "from",
              "value": "{{from}}"
            },
            {
              "key": "to",
              "value": "{{to}}"
            }
          ]
        }
      }
    },
    {
      "name": "Customers top 20",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{analyticsUrl}}/api/analytics/customers/top?limit=20",
          "host": [
            "{{analyticsUrl}}"
          ],
          "path": [
            "api",
            "analytics",
            "customers",
            "top"
          ],
          "query": [
            {
              "key": "limit",
              "value": "20"
            }
          ]
        }
      }
    },
    {
      "name": "Customer metrics",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{analyticsUrl}}/api/analytics/customers/metrics",
          "host": [
            "{{analyticsUrl}}"
          ],
          "path": [
            "api",
            "analytics",
            "customers",
            "metrics"
          ]
        }
      }
    },
    {
      "name": "Benchmark (OLTP vs star vs view)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{analyticsUrl}}/api/analytics/benchmark",
          "host": [
            "{{analyticsUrl}}"
          ],
          "path": [
            "api",
            "analytics",
            "benchmark"
          ]
        }
      }
    },
    {
      "name": "Clear report cache",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{analyticsUrl}}/api/analytics/cache/clear",
          "host": [
            "{{analyticsUrl}}"
          ],
          "path": [
            "api",
            "analytics",
            "cache",
            "clear"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Cache clear reports the deleted count', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().deleted).to.be.a('number');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "API without a token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('A token is required', function () { pm.expect([401, 403]).to.include(pm.response.code); });"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "url": "{{analyticsUrl}}/api/analytics/overview"
      }
    }
  ]
}
