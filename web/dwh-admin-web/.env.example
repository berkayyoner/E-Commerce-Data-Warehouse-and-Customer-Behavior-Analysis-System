# Copy to .env.local to override the defaults for a local run (git-ignored).
REACT_APP_APP_ENV=local
REACT_APP_DEFAULT_LANGUAGE=en

# Either one gateway that serves every service under /api/<service> ...
# REACT_APP_GATEWAY_URL=http://localhost:8080

# ... or one address per service (used only when REACT_APP_GATEWAY_URL is empty).
REACT_APP_AUTH_URL=http://localhost:9000
REACT_APP_ETL_URL=http://localhost:8081
REACT_APP_SHOP_URL=http://localhost:8082
REACT_APP_ANALYTICS_URL=http://localhost:8083
REACT_APP_SEGMENTATION_URL=http://localhost:8084
